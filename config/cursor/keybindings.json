// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+w",
    "command": "-expand_region",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+w",
    "command": "-workbench.action.terminal.killEditor",
    "when": "terminalEditorFocus && terminalFocus && terminalHasBeenCreated || terminalEditorFocus && terminalFocus && terminalProcessSupported"
  },
  {
    "key": "ctrl+e",
    "command": "workbench.action.showCommands",
    "when": "!isGlass"
  },
  {
    "key": "ctrl+shift+p",
    "command": "-workbench.action.showCommands"
  },
  {
    "key": "ctrl+r",
    "command": "workbench.action.quickOpen",
    "when": "!isGlass"
  },
  {
    "key": "ctrl+p",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+q",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+7",
    "command": "-editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+t",
    "command": "-workbench.action.reopenClosedEditor"
  },
  {
    "key": "ctrl+shift+t",
    "command": "-workbench.action.showAllSymbols"
  },
  {
    "key": "ctrl+shift+t",
    "command": "workbench.action.reopenClosedEditor"
  },
  {
    "key": "ctrl+alt+l",
    "command": "-bookmarks.jumpToNext",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+f",
    "command": "editor.action.formatDocument",
    "when": "editorTextFocus && !editorHasSelection"
  },
  {
    "key": "ctrl+shift+f",
    "command": "-editor.action.formatDocument",
    "when": "editorTextFocus && !editorHasSelection"
  },
  {
    "key": "ctrl+alt+f",
    "command": "editor.action.formatSelection",
    "when": "editorHasSelection && editorTextFocus"
  },
  {
    "key": "ctrl+shift+f",
    "command": "-editor.action.formatSelection",
    "when": "editorHasSelection && editorTextFocus"
  },
  {
    "key": "ctrl+shift+[BracketRight]",
    "command": "git.stageSelectedRanges",
    "when": "editorTextFocus && !operationInProgress && resourceScheme == 'file'"
  },
  {
    "key": "ctrl+k ctrl+alt+s",
    "command": "-git.stageSelectedRanges",
    "when": "editorTextFocus && !operationInProgress && resourceScheme == 'file'"
  },
  {
    "key": "ctrl+shift+-",
    "command": "git.unstageSelectedRanges",
    "when": "editorTextFocus && isInDiffEditor && isInDiffRightEditor && !operationInProgress && resourceScheme == 'git'"
  },
  {
    "key": "ctrl+k ctrl+n",
    "command": "-git.unstageSelectedRanges",
    "when": "editorTextFocus && isInDiffEditor && isInDiffRightEditor && !operationInProgress && resourceScheme == 'git'"
  },
  {
    "key": "ctrl+left",
    "command": "-cursorWordPartLeft",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+shift+left",
    "command": "-cursorWordPartLeftSelect",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+right",
    "command": "-cursorWordPartRight",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+shift+right",
    "command": "-cursorWordPartRightSelect",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+left",
    "command": "-cursorWordAccessibilityLeft",
    "when": "accessibilityModeEnabled && isWindows && textInputFocus && focusedView == 'workbench.panel.output'"
  },
  {
    "key": "ctrl+shift+left",
    "command": "-cursorWordAccessibilityLeftSelect",
    "when": "accessibilityModeEnabled && isWindows && textInputFocus && focusedView == 'workbench.panel.output'"
  },
  {
    "key": "ctrl+right",
    "command": "-cursorWordAccessibilityRight",
    "when": "accessibilityModeEnabled && isWindows && textInputFocus && focusedView == 'workbench.panel.output'"
  },
  {
    "key": "ctrl+shift+right",
    "command": "-cursorWordAccessibilityRightSelect",
    "when": "accessibilityModeEnabled && isWindows && textInputFocus && focusedView == 'workbench.panel.output'"
  },
  {
    "key": "ctrl+left",
    "command": "-cursorWordLeft",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+shift+left",
    "command": "-cursorWordLeftSelect",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+left",
    "command": "cursorWordStartLeft"
  },
  {
    "key": "ctrl+shift+left",
    "command": "cursorWordStartLeftSelect"
  },
  {
    "key": "ctrl+alt+down",
    "command": "-editor.action.copyLinesDownAction",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+up",
    "command": "-editor.action.copyLinesUpAction",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+down",
    "command": "editor.action.copyLinesDownAction",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+meta+down",
    "command": "-editor.action.copyLinesDownAction",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+up",
    "command": "editor.action.copyLinesUpAction",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+meta+up",
    "command": "-editor.action.copyLinesUpAction",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+alt+up",
    "command": "-editor.action.copyLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+alt+down",
    "command": "-editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+l",
    "command": "-aichat.newchataction",
    "when": "!isGlass"
  },
  {
    "key": "ctrl+l",
    "command": "-workbench.action.focusBrowserLocationBar",
    "when": "cursor.browserTabEnabled && !auxiliaryBarFocus && !panelFocus && !sideBarFocus && activeEditor == 'workbench.editor.browserEditor'"
  },
  {
    "key": "ctrl+l",
    "command": "-composer.sendToAgent",
    "when": "editorHasPromptBar && editorPromptBarFocused"
  },
  {
    "key": "ctrl+e",
    "command": "glass.openPalette",
    "when": "isGlass"
  },
  {
    "key": "ctrl+k",
    "command": "-glass.openPalette"
  },
  {
    "key": "ctrl+e",
    "command": "-glass.openChangesTab"
  },
  {
    "key": "ctrl+r",
    "command": "glass.openFilePrioritizedPalette",
    "when": "isGlass"
  },
  {
    "key": "ctrl+p",
    "command": "-glass.openFilePrioritizedPalette"
  },
  {
    "key": "ctrl+r",
    "command": "-glass.refreshDiffTab"
  },
  {
    "key": "f1",
    "command": "-workbench.action.showCommands"
  },
  {
    "key": "ctrl+e",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+e",
    "command": "-cursor.toggleAgentWindowIDEUnification",
    "when": "!isGlass && workbenchState != 'empty'"
  },
  {
    "key": "ctrl+e",
    "command": "-editor.action.toggleScreenReaderAccessibilityMode",
    "when": "accessibilityHelpIsShown"
  }
]
