{
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "js/ts.tsserver.maxMemory": 8192,
  "chat.viewSessions.orientation": "stacked",
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.selectedModel": "default",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.accessibilitySupport": "off",
  "editor.codeActionsOnSave": {
    "source.addMissingImports.ts": "explicit",
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "IBM Plex Mono",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "editor.guides.bracketPairs": "active",
  "editor.inlayHints.fontFamily": "default",
  "editor.mouseWheelZoom": true,
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on"
  },
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.wordWrap": "on",
  "files.associations": {
    "*.hcl": "terraform"
  },
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "extensions.ignoreRecommendations": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "dotenv": false,
    "tex": false,
    "json": true,
    "typescript": false,
    "env-spec": false,
    "shellscript": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "githubPullRequests.pullBranch": "never",
  "gitlens.gitkraken.mcp.autoEnabled": false,
  "inlineChat.lineEmptyHint": true,
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "python.analysis.typeCheckingMode": "standard",
  "redhat.telemetry.enabled": true,
  "remote.autoForwardPortsSource": "hybrid",
  "scm.compactFolders": false,
  "search.exclude": {
    "**/.next": true,
    "**/*bun.lock": true,
    "**/build": true,
    "**/dist": true,
    "**/out": true
  },
  "search.useGlobalIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,
  "security.allowedUNCHosts": ["wsl.localhost", "wsl$"],
  "security.workspace.trust.untrustedFiles": "open",
  "svelte.enable-ts-plugin": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.fontSize": 10,
  "typescript.enablePromptUseWorkspaceTsdk": false,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "window.commandCenter": false,
  "workbench.colorTheme": "Cursor Dark High Contrast",
  "workbench.editor.enablePreview": false,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.svg": "default",
    "*.xlsx": "default",
    "git-rebase-todo": "default"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "gitlens.launchpad.indicator.enabled": false,
  "claudeCode.usePythonEnvironment": false,
  "chat.useCustomizationsInParentRepositories": true,
  "chat.tools.urls.autoApprove": {
    "https://*": true,
    "http://*": true
  },
  "chat.agentFilesLocations": {
    "~/.agents/agents": true
  },
  "chat.agentSkillsLocations": {
    "~/.github/skills": true,
    ".copilot/skills": true,
    "~/git/n4bb12/dotfiles/config/~/.agents/skills": true,
    "~/git/n4bb12/dotfiles/config/~/.agents/skills/n4bb12": true,
    "~/git/n4bb12/dotfiles/config/~/.agents/skills/superpowers": true
  },
  "chat.instructionsFilesLocations": {
    "~/.agents": true
  },
  "chat.includeReferencedInstructions": true,
  "chat.mcp.serverSampling": {},
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "chat.agent.sandbox.autoApproveUnsandboxedCommands": true,
  "chat.agent.thinking.collapsedTools": "off",
  "js/ts.experimental.useTsgo": false,
  "typescript.native-preview.tsdk": "node_modules/@typescript/native-preview",
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  "window.menuBarVisibility": "compact",
  "terminal.integrated.commandsToSkipShell": [
    "kilo-code.new.agentManagerOpen",
    "kilo-code.new.agentManager.showTerminal"
  ],
  "kilo-code.new.agentWorkStyle": "skipped",
  "workbench.editor.empty.hint": "hidden",
  "git.confirmSync": false,
  "security.workspace.trust.enabled": false,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  },
  "editor.copyWithSyntaxHighlighting": false,
  "chat.disableAIFeatures": true,
  "[snippets]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "workbench.iconTheme": "material-icon-theme",
  "cursor.cpp.disabledLanguages": [
    "plaintext",
    "markdown",
    "scminput",
    "dotenv",
    "tex",
    "typescript",
    "env-spec",
    "shellscript"
  ],
  "cursor.composer.editorConversationDensity": "compact-all-grouped",
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "cursor.composer.queueMessageDefaultBehavior": "steer",
  "cursor.composer.textSizeScale": 0.85,
  "cursor.composer.usageSummaryDisplay": "always",
  "explorer.confirmDelete": false,
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "GitHub Dark Default"
}
